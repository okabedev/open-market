# 로컬 전용 예시 값이다. 복사해서 .env로 쓰고(`cp .env.example .env`), 실제 비밀 값은 커밋하지 않는다.
# compose.yaml이 이 파일의 값을 읽는다. 값을 바꾸면 Postgres 볼륨을 지우고 다시 띄운다(`docker compose down -v`).

# PostgreSQL 관리자(postgres) 비밀번호
POSTGRES_SUPERUSER_PASSWORD=change-me-local

# 서비스별 DB 계정(<service>_app) 비밀번호. 목록은 infra/postgres/init/services.txt와 같다.
MEMBER_DB_PASSWORD=member-local
CATALOG_DB_PASSWORD=catalog-local
ORDER_DB_PASSWORD=order-local
PAYMENT_DB_PASSWORD=payment-local
FULFILLMENT_DB_PASSWORD=fulfillment-local
PROMOTION_DB_PASSWORD=promotion-local
REVIEW_DB_PASSWORD=review-local
SETTLEMENT_DB_PASSWORD=settlement-local
SEARCH_DB_PASSWORD=search-local
AUTH_DB_PASSWORD=auth-local
FILE_DB_PASSWORD=file-local
NOTIFICATION_DB_PASSWORD=notification-local

# Debezium 복제 계정(debezium) 비밀번호
DEBEZIUM_DB_PASSWORD=debezium-local

# 토스페이먼츠 테스트 키 (개발자센터에서 발급한 test_ 키만 사용)
TOSS_CLIENT_KEY=test_ck_xxx
TOSS_SECRET_KEY=test_sk_xxx

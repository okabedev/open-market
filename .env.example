# 로컬 전용 예시 값이다. 복사해서 .env로 쓰고(`cp .env.example .env`), 실제 비밀 값은 커밋하지 않는다.
# compose.yaml이 이 파일의 값을 읽는다. 값을 바꾸면 Postgres 볼륨을 지우고 다시 띄운다(`docker compose down -v`).

# PostgreSQL 관리자(postgres) 비밀번호
POSTGRES_SUPERUSER_PASSWORD=change-me-local

# 서비스별 DB 계정(<service>_app) 비밀번호. 목록은 infra/postgres/init/services.txt와 같다.
MEMBER_DB_PASSWORD=member-local
CATALOG_DB_PASSWORD=catalog-local
ORDER_DB_PASSWORD=order-local
PAYMENT_DB_PASSWORD=payment-local
FULFILLMENT_DB_PASSWORD=fulfillment-local
PROMOTION_DB_PASSWORD=promotion-local
REVIEW_DB_PASSWORD=review-local
SETTLEMENT_DB_PASSWORD=settlement-local
SEARCH_DB_PASSWORD=search-local
AUTH_DB_PASSWORD=auth-local
FILE_DB_PASSWORD=file-local
NOTIFICATION_DB_PASSWORD=notification-local

# auth: JWT 서명 개인 키 암호화 키(Base64 32바이트, `openssl rand -base64 32`). 바꾸면 저장된 키를 읽지 못하므로 auth 스키마의 signing_key도 지운다.
AUTH_SIGNING_KEY_SECRET=bG9jYWwtb25seS1zaWduaW5nLWtleS1zZWNyZXQtMDA=
# auth: 관리자 2단계 인증(TOTP) 비밀 값 암호화 키(Base64 32바이트, `openssl rand -base64 32`). 서명 키와 다른 값을 쓴다. 바꾸면 등록한 관리자가 로그인하지 못하므로 auth 스키마의 totp_credential도 지운다(관리자는 다음 로그인에 다시 등록한다).
AUTH_TOTP_SECRET_KEY=bG9jYWwtb25seS1hZG1pbi10b3RwLXNlY3JldC1rZXk=

# member: 정산 계좌 번호 암호화 키(Base64 32바이트, `openssl rand -base64 32`). 바꾸면 저장된 계좌 번호를 복호화하지 못한다.
MEMBER_ACCOUNT_NUMBER_KEY=bG9jYWwtb25seS1hY2NvdW50LW51bWJlci1rZXktMDA=

# auth: OAuth2 클라이언트 시크릿. 사용자 클라이언트는 Next.js 앱 서버(BFF)도 이 파일에서 같은 값을 읽는다.
SHOP_CLIENT_SECRET=shop-local-secret
SELLER_CLIENT_SECRET=seller-local-secret
ADMIN_CLIENT_SECRET=admin-local-secret
# 서비스 간 호출(client_credentials). 서비스 이름마다 하나.
MEMBER_CLIENT_SECRET=member-local-secret
NOTIFICATION_CLIENT_SECRET=notification-local-secret
ORDER_CLIENT_SECRET=order-local-secret

# auth: 관리자 시드 계정. auth가 기동할 때 없으면 만든다. 비밀번호는 10자 이상, 영문과 숫자를 포함한다.
ADMIN_SEED_EMAIL=admin@openmarket.local
ADMIN_SEED_PASSWORD=admin-local-1234

# Debezium 복제 계정(debezium) 비밀번호
DEBEZIUM_DB_PASSWORD=debezium-local

# 관측성 읽기 계정(monitor, pg_monitor 역할) 비밀번호. postgres-exporter(obs profile)가 쓴다
MONITOR_DB_PASSWORD=monitor-local

# 토스페이먼츠 주문서형(결제위젯) 테스트 키. 아래는 토스 문서·공식 샘플에 공개된 문서용 테스트 키다(ADR 0018).
# 주문서형 연동 키는 전자결제 신청(사업자 정보) 뒤에만 발급된다. 내 상점 키(test_gck_, test_gsk_)가 생기면 바꾼다. live_ 키는 쓰지 않는다.
TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
# 토스 대신 가짜 PG(infra/fake-pg)를 쓸 때의 주소. 두지 않으면 실제 토스다(빈 값도 두지 않는다). infra/e2e/run.sh가 셸 환경 변수로 준다(docs/dev-setup.md "E2E").
# TOSS_API_URL=http://fake-pg:8090
# TOSS_SDK_URL=http://localhost:8090/v2/standard

    {
      "type": "timeseries",
      "title": "Saga 단계별 지연 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (listener, le) (rate(messaging_event_delay_seconds_bucket{listener=~\"catalog.order-placed|promotion.order-placed|order.stock-reserved|order.stock-reservation-failed|order.coupon-reserved|order.coupon-reservation-failed|payment.order-awaiting-payment|order.payment-approved|catalog.order-paid|promotion.order-paid|fulfillment.order-paid|catalog.order-cancelled|promotion.order-cancelled|payment.order-cancelled\"}[$__rate_interval])))",
          "legendFormat": "{{listener}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 20
      },
      "description": "주문 Saga의 한 단계 = 앞 서비스가 이벤트를 쌓은 때부터 다음 서비스 리스너가 처리를 마칠 때까지(리스너 이름 <서비스>.<이벤트>). 구매자가 결제하는 시간은 들어가지 않는다",
      "id": 9
    }

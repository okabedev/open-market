{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "paths" : {
    "/v1/accounts" : {
      "post" : {
        "tags" : [ "account-command-controller" ],
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterAccountRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RegisterAccountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts/email-verification" : {
      "post" : {
        "tags" : [ "account-command-controller" ],
        "operationId" : "verify",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/v1/accounts/email-verification/resend" : {
      "post" : {
        "tags" : [ "account-command-controller" ],
        "operationId" : "resend",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ResendVerificationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "RegisterAccountRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 320,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          },
          "name" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0
          }
        },
        "required" : [ "email", "name", "password" ]
      },
      "RegisterAccountResponse" : {
        "type" : "object",
        "properties" : {
          "accountId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "VerifyEmailRequest" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "token" ]
      },
      "ResendVerificationRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 320,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      }
    }
  }
}
